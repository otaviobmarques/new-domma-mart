{
  "name": "domma-mart",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:start": "bash scripts/dev-db.sh",
    "db:migrate": "pnpm --filter @domma/db migrate",
    "db:seed": "pnpm --filter @domma/api seed",
    "dev:api": "pnpm --filter @domma/api dev",
    "dev:web": "pnpm --filter @domma/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
