# Banco (PostgreSQL). Em produção: Supabase, conexão direta (não o pooler em modo transação).
DATABASE_URL=postgres://domma_app:domma_app@127.0.0.1:5433/domma
# Usada só pelas migrações (dono das tabelas).
DATABASE_ADMIN_URL=postgres://domma:domma@127.0.0.1:5433/domma

# development | test | production
DOMMA_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Chave de 32 bytes em base64 para criptografia por campo (CPF, CNPJ, chave Pix).
# Gere com: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Segredo para índices cegos (busca por CPF/e-mail sem guardar em claro).
BLIND_INDEX_KEY=

# Provedor de pagamento: sandbox (simulado). Os reais entram como adaptadores.
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=dev-sandbox-secret

# E-mail transacional (Resend). Sem chave, os e-mails saem no log.
RESEND_API_KEY=
EMAIL_FROM=Domma Mart <nao-responda@example.com>

# IA (criador de produto). Sem chave, usa o gerador local simples.
ANTHROPIC_API_KEY=

# E-mails da equipe Domma com acesso ao backoffice (separados por vírgula).
BACKOFFICE_EMAILS=
